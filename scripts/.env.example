# RT-DAD — shared static config (sourced by github-bootstrap.sh and the AWS
# bootstrap script). Only NON-calculated values live here. Calculated values
# (role ARNs, cluster names) come from `terraform output` at run time.
#
# Low-sensitivity by design: account id + region are world-readable in a public
# repo's Actions logs; security rests on the OIDC trust condition, not secrecy.

AWS_REGION=us-west-2
ACCOUNT_ID=123123123123
REPO=rodrigomalara/rt-dad

# Environments to bootstrap (space-separated). Each needs an applied terraform
# env dir at infra/envs/<name>. Add "production" once that env exists.
ENVIRONMENTS=staging
